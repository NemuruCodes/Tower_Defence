<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/HUDstyle.uss?fileID=7433441132597879392&amp;guid=192d01fcaad7c7a4d958f235c8efb1e5&amp;type=3#HUDstyle"/>
    <ui:VisualElement name="Container" class="tower-menu-open" style="flex-grow: 1; align-self: center; justify-content: flex-end;">
        <ui:VisualElement name="PlaceOrCancel" class="Placing NotPlacing" style="transition-duration: 0.6s; opacity: 1;">
            <ui:VisualElement style="flex-grow: 1; flex-direction: row; height: 150px; align-items: auto; justify-content: center; align-self: center; padding-bottom: 10px;">
                <ui:Image scale-mode="ScaleToFit" name="LeftClick" source="project://database/Assets/UIAssets/LeftClick.png?fileID=2800000&amp;guid=1d6450db238f3b946bff5d6eff403570&amp;type=3#LeftClick" style="align-self: center; width: 100px; height: 100px; margin-right: 40px; margin-left: 20px; min-height: 100px; max-height: 100px; align-items: center; flex-wrap: wrap; justify-content: flex-end; flex-direction: column;">
                    <ui:Label text="Confirm" name="Label" style="align-self: center; align-items: center; flex-direction: row; justify-content: flex-start; -unity-text-align: middle-center; -unity-font-style: bold; white-space: nowrap; translate: 5px 25px;"/>
                </ui:Image>
                <ui:Image scale-mode="ScaleToFit" name="RightClick" source="project://database/Assets/UIAssets/RightClick.png?fileID=2800000&amp;guid=df654ccb23dfe2b4799cd4832d698b33&amp;type=3#RightClick" style="align-self: center; width: 100px; height: 100px; margin-right: 20px; margin-left: 40px; min-height: 100px; max-height: 100px; align-items: center; justify-content: flex-end;">
                    <ui:Label text="Cancel" name="Label" style="align-self: center; -unity-text-align: middle-center; -unity-font-style: bold; translate: -5px 25px;"/>
                </ui:Image>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="TowerMenu" class="TowerMenuOpen TowerMenuClosed" style="transition-duration: 1s; transition-timing-function: ease; transition-property: all;">
            <ui:Label text="Resource:" name="ResourceLabel" class="header" style="align-self: flex-start; margin-left: 20px; translate: 0 -60px; position: absolute; top: -11px; left: 9px;"/>
            <ui:Button text="^" name="ToggleButton" style="-unity-text-align: middle-center; align-items: auto; flex-direction: column; top: auto; border-top-left-radius: 5px; border-top-right-radius: 5px; border-bottom-right-radius: 5px; border-bottom-left-radius: 5px; padding-right: 30px; padding-left: 30px; -unity-font-style: bold; font-size: 25px; height: 35px; align-self: center; flex-wrap: nowrap; justify-content: flex-end; translate: 0 -40px;"/>
            <ui:Label text="Tower Menu" class="header" style="align-self: center; justify-content: flex-start; align-items: center; -unity-text-align: middle-center; flex-wrap: nowrap; margin-top: 0; margin-bottom: 0; translate: 0 -20px;"/>
            <ui:VisualElement name="ButtonContainer" style="flex-grow: 1; flex-direction: row; align-self: center; align-items: auto; justify-content: flex-start; margin-bottom: 60px;">
                <ui:Button text="Fireball Tower" name="SingleTarget" class="button tower-button" style="align-self: center; align-items: flex-start; margin-right: 150px; flex-direction: row;">
                    <ui:VisualElement style="flex-grow: 1; translate: 160px 0; align-self: center; justify-content: flex-start; align-items: center; align-content: flex-start;">
                        <ui:Label text="Cost:" name="Cost" data-source="project://database/Assets/Scriptable%20Objects/Towers/SingleTargetTower.asset?fileID=11400000&amp;guid=7f0667db7d0757b4bbb1b9961dd07f2e&amp;type=2#SingleTargetTower" class="buttonLabel" style="flex-wrap: wrap; flex-direction: row; align-items: flex-start; align-self: center; height: 50px; width: 100px; padding-top: 0; padding-left: 5px; -unity-text-align: middle-left;"/>
                        <ui:Label text="DMG:" name="Damage" data-source="project://database/Assets/Scriptable%20Objects/Towers/SingleTargetTower.asset?fileID=11400000&amp;guid=7f0667db7d0757b4bbb1b9961dd07f2e&amp;type=2#SingleTargetTower" class="buttonLabel" style="flex-wrap: wrap; flex-direction: row; align-items: flex-start; align-self: center; height: 50px; width: 100px; padding-left: 5px;"/>
                        <ui:Label text="RNG:" name="Range" data-source="project://database/Assets/Scriptable%20Objects/Towers/SingleTargetTower.asset?fileID=11400000&amp;guid=7f0667db7d0757b4bbb1b9961dd07f2e&amp;type=2#SingleTargetTower" class="buttonLabel" style="flex-wrap: wrap; flex-direction: row; align-items: flex-start; align-self: center; height: 50px; width: 100px; padding-left: 5px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="Labels" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; justify-content: space-between; align-self: center; -unity-text-align: upper-left; max-width: 100px; translate: 150px 0; align-items: flex-start;">
                        <ui:Label text="Label" name="CostLabel" data-source="project://database/Assets/Scriptable%20Objects/Towers/SingleTargetTower.asset?fileID=11400000&amp;guid=7f0667db7d0757b4bbb1b9961dd07f2e&amp;type=2#SingleTargetTower" class="buttonLabel" style="flex-wrap: wrap; flex-direction: row; align-items: flex-start; align-self: center; height: 50px; width: 100px; padding-top: 0; padding-left: 5px; -unity-text-align: middle-left;"/>
                        <ui:Label text="Label" name="DamageLabel" data-source="project://database/Assets/Scriptable%20Objects/Towers/SingleTargetTower.asset?fileID=11400000&amp;guid=7f0667db7d0757b4bbb1b9961dd07f2e&amp;type=2#SingleTargetTower" class="buttonLabel" style="flex-wrap: wrap; flex-direction: row; align-items: flex-start; align-self: center; height: 50px; width: 100px; padding-left: 5px;"/>
                        <ui:Label text="Label" name="RangeLabel" data-source="project://database/Assets/Scriptable%20Objects/Towers/SingleTargetTower.asset?fileID=11400000&amp;guid=7f0667db7d0757b4bbb1b9961dd07f2e&amp;type=2#SingleTargetTower" class="buttonLabel" style="flex-wrap: wrap; flex-direction: row; align-items: flex-start; align-self: center; height: 50px; width: 100px; padding-left: 5px;"/>
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button text="Beam Tower" name="SplashTarget" class="button tower-button" style="margin-right: 150px; flex-direction: row;">
                    <ui:VisualElement style="flex-grow: 1; align-self: center; align-items: center; translate: 160px 0;">
                        <ui:Label text="Cost:" name="Cost" data-source="project://database/Assets/Scriptable%20Objects/Towers/SingleTargetTower.asset?fileID=11400000&amp;guid=7f0667db7d0757b4bbb1b9961dd07f2e&amp;type=2#SingleTargetTower" class="buttonLabel" style="flex-wrap: wrap; flex-direction: row; align-items: flex-start; align-self: center; height: 50px; width: 100px; padding-top: 0; padding-left: 5px; -unity-text-align: middle-left;"/>
                        <ui:Label text="DMG:" name="Damage" data-source="project://database/Assets/Scriptable%20Objects/Towers/SingleTargetTower.asset?fileID=11400000&amp;guid=7f0667db7d0757b4bbb1b9961dd07f2e&amp;type=2#SingleTargetTower" class="buttonLabel" style="flex-wrap: wrap; flex-direction: row; align-items: flex-start; align-self: center; height: 50px; width: 100px; padding-left: 5px;"/>
                        <ui:Label text="RNG:" name="Range" data-source="project://database/Assets/Scriptable%20Objects/Towers/SingleTargetTower.asset?fileID=11400000&amp;guid=7f0667db7d0757b4bbb1b9961dd07f2e&amp;type=2#SingleTargetTower" class="buttonLabel" style="flex-wrap: wrap; flex-direction: row; align-items: flex-start; align-self: center; height: 50px; width: 100px; padding-left: 5px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="Labels" style="flex-grow: 1; flex-direction: row; flex-wrap: wrap; justify-content: flex-start; align-self: center; -unity-text-align: upper-left; translate: 150px 0; align-items: auto;">
                        <ui:Label text="Label" name="CostLabel" data-source="project://database/Assets/Scriptable%20Objects/Towers/SingleTargetTower.asset?fileID=11400000&amp;guid=7f0667db7d0757b4bbb1b9961dd07f2e&amp;type=2#SingleTargetTower" class="buttonLabel" style="flex-wrap: wrap; flex-direction: row; align-items: flex-start; align-self: flex-start; height: 50px; width: 100px; padding-top: 0; padding-left: 5px; -unity-text-align: middle-left; justify-content: flex-start;"/>
                        <ui:Label text="Label" name="DamageLabel" data-source="project://database/Assets/Scriptable%20Objects/Towers/SingleTargetTower.asset?fileID=11400000&amp;guid=7f0667db7d0757b4bbb1b9961dd07f2e&amp;type=2#SingleTargetTower" class="buttonLabel" style="flex-wrap: wrap; flex-direction: row; align-items: flex-start; align-self: center; height: 50px; width: 100px; padding-left: 5px;"/>
                        <ui:Label text="Label" name="RangeLabel" data-source="project://database/Assets/Scriptable%20Objects/Towers/SingleTargetTower.asset?fileID=11400000&amp;guid=7f0667db7d0757b4bbb1b9961dd07f2e&amp;type=2#SingleTargetTower" class="buttonLabel" style="flex-wrap: wrap; flex-direction: row; align-items: flex-start; align-self: center; height: 50px; width: 100px; padding-left: 5px;"/>
                    </ui:VisualElement>
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
